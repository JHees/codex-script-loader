<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifiers Condition="'$(MSBuildProjectName)' == 'CodexScriptLoader.Windows' Or '$(MSBuildProjectName)' == 'CodexScriptLoader.Core' Or '$(MSBuildProjectName)' == 'CodexScriptLoader.Interop'">win-x64;win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <EnableSourceLink Condition="'$(RepositoryUrl)' == ''">false</EnableSourceLink>
    <EnableSourceLink Condition="'$(RepositoryUrl)' != ''">true</EnableSourceLink>
    <PublishRepositoryUrl Condition="'$(RepositoryUrl)' != ''">true</PublishRepositoryUrl>
    <EmbedUntrackedSources Condition="'$(RepositoryUrl)' != ''">true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" Condition="'$(RepositoryUrl)' != ''" />
  </ItemGroup>
</Project>
