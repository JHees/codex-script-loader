<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CodexScriptLoader.Tests</AssemblyName>
    <RootNamespace>CodexScriptLoader.Tests</RootNamespace>
    <RestartFixtureArchitecture Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">arm64</RestartFixtureArchitecture>
    <RestartFixtureArchitecture Condition="'$(RestartFixtureArchitecture)' == ''">x64</RestartFixtureArchitecture>
  </PropertyGroup>
  <Target Name="BuildRestartFixture" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-restart-hook.ps1&quot; -Fixture -Architecture $(RestartFixtureArchitecture) -OutputDirectory &quot;$(MSBuildProjectDirectory)\obj\restart-fixture&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\obj\restart-fixture\NativeRestartFixture.exe" Link="NativeRestartFixture.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodexScriptLoader.Core\CodexScriptLoader.Core.csproj" />
    <ProjectReference Include="..\..\src\CodexScriptLoader.Interop\CodexScriptLoader.Interop.csproj" />
    <ProjectReference Include="..\..\src\CodexScriptLoader.Windows\CodexScriptLoader.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\packages\example-ui-plugin\index.js" Link="fixtures\example-ui-plugin\index.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\manifest.json" Link="fixtures\example-ui-plugin\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\NOTICE.md" Link="fixtures\example-ui-plugin\NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\README.md" Link="fixtures\example-ui-plugin\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\LICENSE" Link="fixtures\example-ui-plugin\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\settings-host.mjs" Link="fixtures\settings-host.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\composer-host.mjs" Link="fixtures\composer-host.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
