<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CodexScriptLoader</AssemblyName>
    <RootNamespace>CodexScriptLoader.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\branding\CodexScriptLoader.ico</ApplicationIcon>
    <ApplicationVersion>0.6.2.0</ApplicationVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <RestartHookArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64')">arm64</RestartHookArchitecture>
    <RestartHookArchitecture Condition="'$(RestartHookArchitecture)' == ''">x64</RestartHookArchitecture>
    <RestartHookOutput>$(MSBuildProjectDirectory)\obj\restart-hook\$(RestartHookArchitecture)</RestartHookOutput>
  </PropertyGroup>
  <Target Name="BuildRestartHook" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-restart-hook.ps1&quot; -Architecture $(RestartHookArchitecture) -OutputDirectory &quot;$(RestartHookOutput)&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="$(RestartHookOutput)\CodexScriptLoader.RestartHook.dll" Link="CodexScriptLoader.RestartHook.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexScriptLoader.Core\CodexScriptLoader.Core.csproj" />
    <ProjectReference Include="..\CodexScriptLoader.Interop\CodexScriptLoader.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\packages\example-ui-plugin\index.js" Link="bundled\example-ui-plugin\index.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\manifest.json" Link="bundled\example-ui-plugin\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\NOTICE.md" Link="bundled\example-ui-plugin\NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\README.md" Link="bundled\example-ui-plugin\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\packages\example-ui-plugin\LICENSE" Link="bundled\example-ui-plugin\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\settings-host.mjs" Link="bundled\settings-host.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\composer-host.mjs" Link="bundled\composer-host.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
